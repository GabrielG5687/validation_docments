generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id              String           @id @default(uuid())
  nome            String
  email           String           @unique
  perfil          Perfil           @default(usuario)
  status          Boolean          @default(true)
  criadoEm        DateTime         @default(now())
  senhaHash       String
  convitesCriados ConviteEmpresa[] @relation("ConviteCriadoPor")
  documentos      Documento[]
  entidades       Entidade[]
  membrosEmpresas MembroEmpresa[]
  notificacoes    Notificacao[]
  validacoes      Validacao[]

  @@map("usuarios")
}

model Empresa {
  id           String           @id @default(uuid())
  nome         String
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt
  convites     ConviteEmpresa[]
  entidades    Entidade[]
  membros      MembroEmpresa[]
  templates    Template[]

  @@map("empresas")
}

model MembroEmpresa {
  id           String       @id @default(uuid())
  empresaId    String
  usuarioId    String
  papel        PapelEmpresa @default(MEMBER)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([empresaId, usuarioId])
  @@index([usuarioId])
  @@map("membros_empresa")
}

model ConviteEmpresa {
  id          String               @id @default(uuid())
  empresaId   String
  email       String
  papel       PapelEmpresa         @default(MEMBER)
  tokenHash   String               @unique
  status      StatusConviteEmpresa @default(pendente)
  expiraEm    DateTime
  aceitoEm    DateTime?
  criadoPorId String
  criadoEm    DateTime             @default(now())
  criadoPor   Usuario              @relation("ConviteCriadoPor", fields: [criadoPorId], references: [id])
  empresa     Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, status])
  @@index([email])
  @@map("convites_empresa")
}

model Template {
  id           String           @id @default(uuid())
  nome         String
  descricao    String?
  categoria    String?
  status       StatusTemplate   @default(rascunho)
  versaoAtual  String           @default("1.0")
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @updatedAt
  estrutura    Json?
  validadeDias Int?
  empresaId    String?
  documentos   Documento[]
  dossieItens  DossieItem[]
  regras       RegraValidacao[]
  versoes      TemplateVersao[]
  empresa      Empresa?         @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("templates")
}

model TemplateVersao {
  id          String   @id @default(uuid())
  templateId  String
  versao      String
  snapshot    Json
  publicadoEm DateTime @default(now())
  template    Template @relation(fields: [templateId], references: [id])

  @@map("template_versoes")
}

model RegraValidacao {
  id          String           @id @default(uuid())
  templateId  String
  nome        String
  tipo        TipoRegra
  parametros  Json
  obrigatoria Boolean          @default(true)
  ativo       Boolean          @default(true)
  ordem       Int
  criadoEm    DateTime         @default(now())
  template    Template         @relation(fields: [templateId], references: [id])
  resultados  ResultadoRegra[]

  @@map("regras_validacao")
}

model Documento {
  id                  String            @id @default(uuid())
  usuarioId           String
  templateId          String
  nomeArquivo         String
  minioKey            String
  hashSha256          String
  dadosExtraidos      Json?
  status              StatusDocumento   @default(processando)
  codigoVerificacao   String?           @unique
  qrcodeKey           String?
  documentoOrigemId   String?
  criadoEm            DateTime          @default(now())
  atualizadoEm        DateTime          @updatedAt
  dataEmissao         DateTime?
  dataValidade        DateTime?
  diasParaVencer      Int?
  dossieItemId        String?
  entidadeId          String?
  renovacaoNecessaria Boolean?          @default(false)
  statusValidade      ValidadeStatus?
  dossieItem          DossieItem?       @relation("ItemEnvio", fields: [dossieItemId], references: [id])
  entidade            Entidade?         @relation(fields: [entidadeId], references: [id])
  template            Template          @relation(fields: [templateId], references: [id])
  usuario             Usuario           @relation(fields: [usuarioId], references: [id])
  itensAtuais         DossieItem[]      @relation("ItemAtual")
  historico           HistoricoStatus[]
  validacoes          Validacao[]

  @@unique([usuarioId, hashSha256])
  @@index([usuarioId])
  @@index([templateId])
  @@index([status])
  @@index([codigoVerificacao])
  @@index([criadoEm])
  @@index([entidadeId])
  @@index([statusValidade])
  @@map("documentos")
}

model Validacao {
  id              String           @id @default(uuid())
  documentoId     String
  validadorId     String
  resultado       String
  observacoes     String?
  criadoEm        DateTime         @default(now())
  resultadosRegra ResultadoRegra[]
  documento       Documento        @relation(fields: [documentoId], references: [id])
  validador       Usuario          @relation(fields: [validadorId], references: [id])

  @@map("validacoes")
}

model ResultadoRegra {
  id              String         @id @default(uuid())
  validacaoId     String
  regraId         String
  status          String
  valorEncontrado String?
  criterio        String?
  explicacaoIa    String?
  criadoEm        DateTime       @default(now())
  regra           RegraValidacao @relation(fields: [regraId], references: [id])
  validacao       Validacao      @relation(fields: [validacaoId], references: [id])

  @@map("resultados_regra")
}

model HistoricoStatus {
  id             String    @id @default(uuid())
  documentoId    String
  statusAnterior String?
  statusNovo     String
  usuarioId      String?
  criadoEm       DateTime  @default(now())
  documento      Documento @relation(fields: [documentoId], references: [id])

  @@index([documentoId])
  @@map("historico_status")
}

model Entidade {
  id                     String       @id @default(uuid())
  tipo                   TipoEntidade
  nome                   String
  documentoIdentificador String?
  cnpjOuCpf              String?
  responsavelId          String?
  criadoEm               DateTime     @default(now())
  atualizadoEm           DateTime     @updatedAt
  empresaId              String?
  documentos             Documento[]
  dossies                Dossie[]
  empresa                Empresa?     @relation(fields: [empresaId], references: [id])
  responsavel            Usuario?     @relation(fields: [responsavelId], references: [id])

  @@index([responsavelId])
  @@index([empresaId])
  @@map("entidades")
}

model Dossie {
  id           String       @id @default(uuid())
  entidadeId   String
  nome         String
  descricao    String?
  status       DossieStatus @default(em_compliance)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  itens        DossieItem[]
  entidade     Entidade     @relation(fields: [entidadeId], references: [id])

  @@index([entidadeId])
  @@map("dossies")
}

model DossieItem {
  id          String      @id @default(uuid())
  dossieId    String
  templateId  String
  documentoId String?
  obrigatorio Boolean     @default(true)
  ordem       Int
  criadoEm    DateTime    @default(now())
  documentos  Documento[] @relation("ItemEnvio")
  documento   Documento?  @relation("ItemAtual", fields: [documentoId], references: [id])
  dossie      Dossie      @relation(fields: [dossieId], references: [id])
  template    Template    @relation(fields: [templateId], references: [id])

  @@index([dossieId])
  @@index([templateId])
  @@map("dossie_itens")
}

model Notificacao {
  id             String   @id @default(uuid())
  destinatarioId String
  tipo           String
  titulo         String
  mensagem       String
  lida           Boolean  @default(false)
  documentoId    String?
  dossieId       String?
  entidadeId     String?
  criadoEm       DateTime @default(now())
  destinatario   Usuario  @relation(fields: [destinatarioId], references: [id])

  @@index([destinatarioId, lida])
  @@index([criadoEm])
  @@map("notificacoes")
}

enum Perfil {
  usuario
  validador
  coordenador
  admin
}

enum StatusTemplate {
  rascunho
  ativo
  inativo
}

enum TipoRegra {
  campo_obrigatorio
  formato
  intervalo
  calculo
}

enum StatusDocumento {
  processando
  aguardando_validacao
  aguardando_revisao
  em_revisao
  aprovado
  reprovado
  reprovado_automatico
  erro_extracao
}

enum TipoEntidade {
  empresa
  pessoa
}

enum DossieStatus {
  em_compliance
  pendente
  aprovado
}

enum ValidadeStatus {
  valido
  proximo_vencimento
  vencido
  sem_validade
}

enum PapelEmpresa {
  OWNER
  ADMIN
  MEMBER
}

enum StatusConviteEmpresa {
  pendente
  aceito
  expirado
  revogado
}
